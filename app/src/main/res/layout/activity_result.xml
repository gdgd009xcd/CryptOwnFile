<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="20dp"
android:weightSum="10"
>

<!-- タイトル -->
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="処理結果"
    android:textSize="20sp"
    android:textStyle="bold"
    android:layout_marginBottom="20dp"/>

<!-- 全画面（残りのエリア全体）でスクロール可能なテキスト表示 -->
<EditText
    android:id="@+id/editTextResultFull"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="8"
    android:text="ここに結果が表示されます"
    android:textSize="16sp"
    android:scrollbars="vertical"
    android:inputType="textMultiLine"
    android:gravity="top|start"
    android:padding="12dp" />

<!-- 【新規追加】暗号化上書き保存ボタン -->
<Button
        android:id="@+id/buttonOverwriteSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="上書き保存"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

<!-- ファイル即時削除ボタン -->
<Button
    android:id="@+id/buttonDeleteFile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:text="暗号化ファイルを即時削除"
    android:backgroundTint="#D32F2F"
    android:textColor="#FFFFFF" />

<!-- 閉じるボタン -->
<Button
    android:id="@+id/buttonClose"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="この画面を閉じる" />

    <TextView
        android:id="@+id/textViewResultMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lines="3"
        android:text="結果がここに表示されます"
        android:textSize="16sp" />
</LinearLayout>
